{
  "name": "Zevium.dev Development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "arktypeio.arkdark",
        "formulahendry.auto-rename-tag",
        "aaron-bond.better-comments",
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "tobermory.es6-string-html",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "bierner.github-markdown-preview",
        "codezombiech.gitignore",
        "wix.vscode-import-cost",
        "oderwat.indent-rainbow",
        "swiftlydaniel.oklch-color-visualiser",
        "csstools.postcss",
        "hoovercj.vscode-power-mode",
        "esbenp.prettier-vscode",
        "yoavbls.pretty-ts-errors",
        "foxundermoon.shell-format",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.watcherExclude": {
          "**/routeTree.gen.ts": true,
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/dist/**": true,
          "**/.output/**": true
        },
        "search.exclude": {
          "**/routeTree.gen.ts": true,
          "**/node_modules": true,
          "**/dist": true,
          "**/.output": true
        },
        "files.readonlyInclude": {
          "**/routeTree.gen.ts": true
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
          ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],
        "emmet.includeLanguages": {
          "typescript": "html",
          "typescriptreact": "html"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.autofetch": true,
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
          "*.ts": "${capture}.js",
          "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
          "*.jsx": "${capture}.js",
          "*.tsx": "${capture}.ts",
          "tsconfig.json": "tsconfig.*.json",
          "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, .yarnrc"
        }
      }
    }
  },

  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": {
      "label": "Development Server",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Preview Server",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "mounts": ["source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,consistency=cached"],

  "remoteUser": "node"
}
