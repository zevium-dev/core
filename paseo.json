{
  "worktree": {
    "setup": "mise trust --yes --quiet"
  },
  "scripts": {
    "setup": {
      "command": "cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" .env; cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env.local\" .env.local; pnpm i"
    },
    "dev": {
      "type": "service",
      "command": "pnpm dev"
    },
    "check": {
      "command": "pnpm ci:pr"
    }
  }
}
