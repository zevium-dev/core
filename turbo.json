{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_BUILD_SHA",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_CONVEX_URL",
        "VITE_GATEWAY_URL"
      ],
      "passThroughEnv": ["CLERK_SECRET_KEY"],
      "outputs": [
        "dist/**",
        "!dist/server/.dev.vars",
        ".output/**",
        ".nitro/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
