# Polar billing (user-scoped: Polar customer externalId = userId)
POLAR_ACCESS_TOKEN=REDACTED
POLAR_WEBHOOK_SECRET=REDACTED
POLAR_SERVER=sandbox
POLAR_METER_ID=REDACTED
# Top-up products are FIXED one-time Polar products (no metered price), each
# granting a fixed number of meter-credit units via a meter_credit benefit.
# The client reads these IDs to call auth.checkout({ products: [id] }).
# Format: JSON array of { id, label, priceCents, units }.
VITE_PUBLIC_POLAR_TOPUP_PRODUCTS='[{"id":"prd_REDACTED","label":"$20","priceCents":2000,"units":2000}]'

# Cap CAPTCHA secret (>=16 bytes, consistent across processes)
# Generate: openssl rand -base64 32
