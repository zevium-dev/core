# Web / Clerk / Convex
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REDACTED
CLERK_SECRET_KEY=sk_test_REDACTED
CLERK_JWT_ISSUER_DOMAIN=https://REDACTED.clerk.accounts.dev
VITE_CONVEX_URL=https://REDACTED.convex.cloud
VITE_GATEWAY_URL=http://localhost:8787
CONVEX_DEPLOYMENT=dev:REDACTED
CONVEX_URL=https://REDACTED.convex.cloud

# Convex runtime
APP_ORIGIN=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REDACTED
ADMIN_USER_IDS=user_REDACTED
GEMINI_API_KEY=REDACTED
# JSON keyring: retain prior ids until every credential and webhook signing
# secret has been re-encrypted.
UPSTREAM_CREDENTIAL_ENCRYPTION_KEYS={"current":"v1","keys":{"v1":"REDACTED_32_PLUS_BYTE_SECRET"}}
# Shared by authenticated web server projection and Convex verification only.
# Local web Worker also needs this binding in apps/web/.dev.vars.
REGISTRY_KEY_PROJECTION_HMAC_SECRET=REDACTED
# Registry v2 producer transport. Receiver implementation remains blocked.
GATEWAY_REGISTRY_SYNC_BASE_URL=http://localhost:8787
GATEWAY_REGISTRY_SYNC_HMAC_SECRET=REDACTED
GATEWAY_REGISTRY_TRANSPORT_KEYRING={"current":"v1","keys":{"v1":"REDACTED_32_BYTE_BASE64_OR_HEX_KEY"}}

# Optional Convex email delivery; unset key leaves notifications in-app only.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Stripe Checkout + Connect
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_CONNECT_V2_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_CONNECT_V2_PLATFORM_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_PRICE_PACK_10=price_REDACTED
STRIPE_PRICE_PACK_50=price_REDACTED
STRIPE_PRICE_PACK_100=price_REDACTED
# Own account ID is required for Checkout and Connect; Balance read access
# verifies test/live mode. HMAC key is required for transfer crash correlation.
STRIPE_PLATFORM_ACCOUNT_ID=acct_REDACTED
STRIPE_TRANSFER_CORRELATION_SECRET=REDACTED_AT_LEAST_32_BYTES

# Browser journeys (test credentials only)
E2E_BASE_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8787
