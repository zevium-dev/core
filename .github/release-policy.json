{
  "schemaVersion": 1,
  "repository": "zevium-dev/core",
  "targetBranch": "develop",
  "evaluator": ".github/scripts/release-attestation.mjs",
  "requiredWorkflow": ".github/workflows/release-policy.yml",
  "requiredCheck": "Immutable Release Policy Review / evaluate",
  "requiredEnvironment": "production-policy",
  "refereeRefVariable": "RELEASE_REFEREE_REF",
  "evaluatorDigestVariable": "RELEASE_REFEREE_SHA256",
  "policyTreeDigestVariable": "RELEASE_POLICY_TREE_SHA256",
  "preventSelfReview": true,
  "adminBypass": false,
  "mergeTopology": "linear-single-parent",
  "refereePaths": [
    ".github/release-policy.json",
    ".github/scripts/",
    ".github/workflows/",
    "e2e/",
    "package.json",
    "pnpm-lock.yaml"
  ]
}
