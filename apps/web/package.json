{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "node ../../scripts/quality/tracked-tree.mjs -- node scripts/build.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives --no-ignore --disable-nested-config src scripts/build-env.mjs scripts/build-env.test.mjs scripts/build.mjs scripts/test-csrf-runtime.mjs vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "test": "vitest run --allowOnly=false",
    "test:csrf-runtime": "node scripts/test-csrf-runtime.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@convex-dev/react-query": "^0.1.0",
    "@lezer/highlight": "^1.2.3",
    "@speed-highlight/core": "^1.2.17",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.44",
    "@tanstack/router-plugin": "1.168.19",
    "@uiw/react-codemirror": "^4.25.11",
    "@zevium/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/codemirror": "^5.60.17",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.120.1"
  },
  "optionalDependencies": {
    "utf-8-validate": "5.0.10"
  }
}
