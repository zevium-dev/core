{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zevium-gateway-preview",
  "account_id": "1ea9299555b026a6a7484c8323c5a953",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "WALLET", "class_name": "WalletSqliteDO" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalletDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ControlDO"] },
    { "tag": "v3", "deleted_classes": ["ControlDO"] },
    {
      "tag": "v4-wallet-sqlite",
      "new_sqlite_classes": ["WalletSqliteDO"],
      "deleted_classes": ["WalletDO"],
    },
  ],
}
