{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zevium-gateway-preview",
  "account_id": "1ea9299555b026a6a7484c8323c5a953",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "WALLET", "class_name": "WalletDO" },
      { "name": "CONTROL", "class_name": "ControlDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalletDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ControlDO"] },
  ],
}
