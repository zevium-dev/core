{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zevium-gateway-staging",
  "account_id": "1ea9299555b026a6a7484c8323c5a953",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "routes": [
    { "pattern": "gateway-staging.zevium.dev", "custom_domain": true },
  ],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "WALLET", "class_name": "WalletDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "X402_PAYMENTS", "class_name": "X402PaymentDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalletDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryDO"] },
    { "tag": "v3", "new_sqlite_classes": ["X402PaymentDO"] },
  ],
}
