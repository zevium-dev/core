{
  "name": "zevium-gateway",
  "account_id": "1ea9299555b026a6a7484c8323c5a953",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // Cloudflare global fetch rejects private-network targets at the egress
  // boundary. URL policy below remains defense in depth.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "routes": [{ "pattern": "gateway.zevium.dev", "custom_domain": true }],
  // Dev-only origin for generated discovery links; otherwise Wrangler infers
  // the production route above. Override --host too when changing --port.
  "dev": { "host": "localhost:8787" },
  "vars": {
    // Override with the paired web origin for preview deployments.
    "APP_ORIGIN": "https://zevium.dev",
    // CLERK_SECRET_KEY — optional Clerk OAuth verification secret
    // GATEWAY_INTERNAL_SECRET — paired snapshot/settlement HTTP authentication
    // NEXT_DEPLOYMENT_ID + NEXT_SNAPSHOT_KEYS/NEXT_ADMISSION_KEYS/NEXT_TRANSPORT_KEYS
    // must match Convex; set keys as secrets, never commit values.
    // MCP_OAUTH_ISSUER + MCP_OAUTH_RESOURCE — optional OAuth activation; configure
    // in Worker settings after Clerk DCR/PKCE/scopes setup. Every deploy must use
    // --keep-vars (or supply both explicitly); default deploy removes dashboard vars.
    // GATEWAY_TEST_MODE — "1" only in vitest (see vitest config)
    "CONVEX_URL": "",
    "CONVEX_SITE_URL": "",
    // Deployment workflow overrides this with exact develop SHA.
    "ZEVIUM_RELEASE": "0000000000000000000000000000000000000000",
  },
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "EDGE_OAUTH", "class_name": "EdgeOAuthDO" },
      { "name": "EDGE_SNAPSHOTS", "class_name": "EdgeSnapshotDO" },
      { "name": "NEXT_WALLET", "class_name": "NextWalletDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WalletDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ControlDO"],
    },
    { "tag": "v3", "deleted_classes": ["ControlDO"] },
    {
      "tag": "v4-wallet-sqlite",
      "new_sqlite_classes": ["WalletSqliteDO"],
      "deleted_classes": ["WalletDO"],
    },
    {
      "tag": "v5-next-edge",
      "new_sqlite_classes": ["EdgeSnapshotDO", "NextWalletDO", "EdgeOAuthDO"],
    },
    {
      "tag": "v6-control-plane-cutover",
      "deleted_classes": ["WalletSqliteDO"],
    },
  ],
}
