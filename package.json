{
  "name": "zevium.dev",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "cf-typegen": "wrangler types --env-interface Env",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check",
    "ci:pr": "pnpm run typecheck && pnpm run lint:changed && pnpm run test && pnpm run format:check:changed",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev",
    "dev:workerd": "wrangler dev",
    "eslint": "pnpm run lint",
    "format": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content --fix \"src/**/*.{ts,tsx,js,jsx}\" \"scripts/**/*.{ts,tsx,js,jsx}\" \"plugins/**/*.{ts,tsx,js,jsx}\" \"types/**/*.{ts,tsx}\" \"types/**/*.d.ts\" \"*.{ts,tsx,js,jsx,mjs,cjs}\" && prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\" \"plugins/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\" \"types/**/*.{ts,tsx,d.ts,json,css,md,yml,yaml}\" \"*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:changed": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/run-changed.mjs eslint --ext ts,tsx,js,jsx -- --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content --no-warn-ignored --fix && node scripts/run-changed.mjs prettier --ext ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml -- --write",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\" \"plugins/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\" \"types/**/*.{ts,tsx,d.ts,json,css,md,yml,yaml}\" \"*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:check:changed": "node scripts/run-changed.mjs prettier --ext ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml -- --check",
    "generate-routes": "timeout 5s pnpm dev --port 55173",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content \"src/**/*.{ts,tsx,js,jsx}\" \"scripts/**/*.{ts,tsx,js,jsx}\" \"plugins/**/*.{ts,tsx,js,jsx}\" \"types/**/*.{ts,tsx}\" \"types/**/*.d.ts\" \"*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "lint:changed": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/run-changed.mjs eslint --ext ts,tsx,js,jsx -- --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content --no-warn-ignored",
    "precheck": "pnpm run typecheck && pnpm run format:check",
    "prepush": "pnpm run typecheck && pnpm run format",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsgo --noEmit"
  },
