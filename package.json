{
  "name": "zevium",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:ci": "node scripts/quality/build-ci.mjs",
    "ci:pr": "pnpm format:check && pnpm lint && pnpm quality:static && pnpm typecheck && pnpm test && pnpm ci:control-plane && pnpm build:ci && pnpm routes:check && pnpm diff:check",
    "build:production": "node scripts/build.mjs",
    "dev": "pnpm predev && concurrently --kill-others-on-fail --names web,convex,gateway --prefix-colors blue,magenta,green \"pnpm --filter web dev\" \"pnpm exec convex dev\" \"pnpm --filter @zevium/gateway dev\"",
    "diff:check": "git diff --check",
    "e2e": "bash e2e/run-all.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives --disable-nested-config .",
    "quality:actions": "mise exec -- actionlint",
    "quality:gitleaks": "node scripts/quality/check-gitleaks.mjs",
    "quality:shell": "mise exec -- shellcheck --severity=warning e2e/*.sh",
    "quality:static": "pnpm quality:actions && pnpm quality:shell && pnpm quality:gitleaks",
    "routes:check": "git diff --exit-code -- convex/_generated apps/web/src/routeTree.gen.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "CI=true turbo test --concurrency=1 -- --maxWorkers=2 && pnpm test:convex && pnpm test:worktree-setup && pnpm test:seed && pnpm --filter @zevium/gateway test:dev-origin",
    "test:convex": "vitest run --allowOnly=false --maxWorkers=2 --config vitest.convex.config.ts",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json",
    "test:seed": "node --test scripts/seed.test.mjs",
    "test:worktree-setup": "node --test scripts/copy-worktree-env.test.mjs",
    "ci:control-plane": "pnpm contracts:check && tsx --test scripts/control-plane/activation.test.mjs scripts/control-plane/guards.test.mjs && pnpm schema:check && pnpm test:races",
    "contracts:check": "tsx scripts/control-plane/check-contracts.ts",
    "schema:check": "node scripts/control-plane/validate-local.mjs",
    "test:races": "node scripts/control-plane/races.mjs",
    "activation:check": "tsx scripts/control-plane/validate-activation.mjs",
    "predev": "node scripts/control-plane/guard-dev.mjs"
  },
  "devDependencies": {
    "@clerk/backend": "^3.22.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "26.6.4",
    "agent-browser": "0.38.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.60",
    "eslint-plugin-security": "4.2.0",
    "oxlint": "1.78.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/resend": "^0.2.9",
    "@zevium/shared": "workspace:*",
    "convex": "^1.46.0",
    "stripe": "23.0.0",
    "svix": "^1.96.1",
    "zod": "^4.6.5"
  },
  "type": "module"
}
