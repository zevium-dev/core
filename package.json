  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "cf-typegen": "wrangler types --env-interface Env",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check",
    "ci:pr": "pnpm run typecheck && pnpm run lint:changed && pnpm run test && pnpm run format:check:changed",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev",
    "dev:workerd": "wrangler dev",
    "format": "sort-package-json && oxfmt --write .",
    "format:changed": "node scripts/run-changed.mjs oxfmt --ext ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml -- --write",
    "format:check": "oxfmt --check .",
    "format:check:changed": "node scripts/run-changed.mjs oxfmt --ext ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml -- --check",
    "format:eslint": "eslint --fix .",
    "generate-routes": "timeout 5s pnpm dev --port 55173",
    "lint": "oxlint .",
    "lint:changed": "node scripts/run-changed.mjs oxlint --ext ts,tsx,js,jsx --",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix .",
    "precheck": "pnpm run typecheck && pnpm run format:check",
    "prepush": "pnpm run typecheck && pnpm run format",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsgo --noEmit"
  },
