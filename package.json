{
  "name": "zevium",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,convex,gateway --prefix-colors blue,magenta,green \"pnpm --filter web dev\" \"pnpm exec convex dev\" \"pnpm --filter @zevium/gateway dev\"",
    "build": "turbo build",
    "ci:pr": "prettier --check . && pnpm lint && pnpm typecheck && pnpm test",
    "test": "turbo test && pnpm test:convex && pnpm test:release",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:release": "vitest run .github/scripts/release.test.ts",
    "typecheck": "turbo typecheck",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "e2e": "bash e2e/run-all.sh"
  },
  "devDependencies": {
    "@clerk/backend": "^3.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clerk/backend": "^3.14.0",
    "@zevium/shared": "workspace:*",
    "convex": "^1.42.3",
    "stripe": "22.3.1",
    "svix": "^1.96.1"
  },
  "type": "module"
}
