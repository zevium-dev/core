{
  "name": "zevium",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,convex,gateway --prefix-colors blue,magenta,green \"pnpm --filter web dev\" \"pnpm exec convex dev\" \"pnpm --filter @zevium/gateway dev\"",
    "build": "turbo build",
    "ci:pr": "prettier --check . && pnpm check:compliance-claims && pnpm typecheck && pnpm test",
    "check:compliance-claims": "pnpm test:compliance-claims && node scripts/check-compliance-claims.mjs",
    "check:compliance-claims:deploy": "pnpm test:compliance-claims && node scripts/check-compliance-claims.mjs --require-generated",
    "build:compliance-inputs": "pnpm --filter web build && pnpm --filter @zevium/gateway build:compliance",
    "test": "turbo test && pnpm test:convex",
    "test:compliance-claims": "node --test scripts/check-compliance-claims.test.mjs && pnpm --filter @zevium/shared exec vitest run src/public-claims.test.ts",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "e2e": "bash e2e/run-all.sh"
  },
  "devDependencies": {
    "@clerk/backend": "^3.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.54",
    "prettier": "^3.6.0",
    "tsx": "^4.23.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@zevium/shared": "workspace:*",
    "convex": "^1.42.3",
    "stripe": "22.3.1",
    "svix": "^1.96.1"
  },
  "type": "module"
}
