{
  "name": "zevium",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,convex,gateway --prefix-colors blue,magenta,green \"pnpm --filter web dev\" \"pnpm exec convex dev\" \"pnpm --filter @zevium/gateway dev\"",
    "build": "turbo build",
    "audit:ci": "node scripts/audit.mjs",
    "ci:pr": "prettier --check . && pnpm typecheck && pnpm test",
    "test": "turbo test && pnpm test:convex && pnpm test:audit",
    "test:audit": "node --test scripts/audit.test.mjs",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "e2e": "bash e2e/run-all.sh"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.4",
    "@edge-runtime/vm": "^5.0.0",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.54",
    "prettier": "^3.6.0",
    "semver": "7.8.5",
    "tsx": "^4.23.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@zevium/shared": "workspace:*",
    "convex": "^1.42.3",
    "stripe": "22.3.1",
    "svix": "^1.96.1"
  },
  "type": "module"
}
