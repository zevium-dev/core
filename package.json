{
  "name": "zevium",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,convex,gateway --prefix-colors blue,magenta,green \"pnpm --filter web dev\" \"pnpm exec convex dev\" \"pnpm --filter @zevium/gateway dev\"",
    "build": "turbo build",
    "build:ci": "node scripts/quality/build-ci.mjs",
    "bundle:check": "node scripts/quality/check-bundles.mjs",
    "ci:pr": "pnpm format:check && pnpm lint && pnpm quality:static && pnpm typecheck && pnpm test && pnpm build:ci && pnpm bundle:check && pnpm diff:check",
    "diff:check": "git diff --check",
    "format:check": "prettier --check .",
    "test": "turbo test && pnpm test:convex && pnpm test:quality",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:quality": "node --test scripts/quality/quality.test.mjs",
    "typecheck": "turbo typecheck",
    "lint": "node scripts/quality/check-turbo-lint.mjs && turbo lint && pnpm lint:repo",
    "lint:repo": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives convex scripts/*.ts scripts/quality/*.mjs .github/scripts",
    "quality:actions": "mise exec -- actionlint",
    "quality:gitleaks": "mise exec -- gitleaks dir --no-banner --redact .",
    "quality:shell": "mise exec -- shellcheck --severity=warning e2e/*.sh",
    "quality:static": "pnpm quality:structured && pnpm quality:tests && pnpm quality:actions && pnpm quality:shell && pnpm quality:gitleaks",
    "quality:structured": "node scripts/quality/check-structured-data.mjs",
    "quality:tests": "node scripts/quality/check-test-focus.mjs",
    "routes:check": "node scripts/quality/check-generated-routes.mjs",
    "format": "prettier --write .",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "e2e": "bash e2e/run-all.sh"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@clerk/backend": "^3.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.54",
    "eslint-plugin-security": "4.0.1",
    "oxlint": "1.78.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@zevium/shared": "workspace:*",
    "convex": "^1.42.3",
    "stripe": "22.3.1",
    "svix": "^1.96.1"
  },
  "type": "module"
}
